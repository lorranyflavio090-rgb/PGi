 * Convenção de intervalo: [esq, dir)
 */

#include <iostream>
#include <vector>

using namespace std;

/**
 * Realiza a busca sequencial alternativa iterativa no intervalo semiaberto [esq, dir).
 * A busca inspeciona simultaneamente as duas pontas do intervalo,
 * aproximando os limites esquerdo e direito ate que se cruzem.
 * 
 * @param arr Vetor com os elementos inteiros.
 * @param esq Limite inferior do intervalo (inclusivo).
 * @param dir Limite superior do intervalo (exclusivo).
 * @param x Elemento procurado.
 * @return Indice onde o elemento foi encontrado, ou -1 caso contrario.
 */
int buscaSequencialAlternativaIterativa(const vector<int>& arr, int esq, int dir, int x) {
    // Como 'dir' e exclusivo, o ultimo elemento valido da direita esta no indice dir - 1
    int i = esq;
    int j = dir - 1;

    // O laco continua enquanto os indices nao se cruzarem
    while (i <= j) {
        // Verifica o elemento da extremidade esquerda atual
        if (arr[i] == x) {
            return i;
        }

        // Verifica o elemento da extremidade direita atual
        if (arr[j] == x) {
            return j;
        }

        // Move a extremidade esquerda para frente
        i++;
        // Move a extremidade direita para tras
        j--;
    }

    // Elemento nao encontrado dentro do intervalo [esq, dir)
    return -1;
}

int main() {
    // Otimizacao de entrada e saida padrao
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, x;

    // Leitura da quantidade N e do elemento alvo X
    if (!(cin >> n >> x)) {
        return 0;
    }

    // Alocacao dinamica do vetor para suportar testes de larga escala
    vector<int> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    // Execucao da busca sequencial alternativa iterativa no intervalo [0, n)
    int resultado = buscaSequencialAlternativaIterativa(arr, 0, n, x);

    // Exibicao do resultado
    if (resultado != -1) {
        cout << "Elemento encontrado no indice: " << resultado << "\n";
    } else {
        cout << "Elemento nao encontrado\n";
    }

    return 0;
}

