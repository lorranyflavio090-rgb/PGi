 * Exercício 8: Busca Ternária Recursiva
 * Convenção de intervalo: [esq, dir)
 */

#include <iostream>
#include <vector>

using namespace std;

/**
 * Realiza a busca ternaria recursiva no intervalo semiaberto [esq, dir).
 * O array DEVE estar previamente ordenado de forma crescente.
 * 
 * @param arr Vetor ordenado contendo os elementos inteiros.
 * @param esq Limite inferior do intervalo (inclusivo).
 * @param dir Limite superior do intervalo (exclusivo).
 * @param x Elemento procurado.
 * @return Indice onde o elemento foi encontrado, ou -1 caso contrario.
 */
int buscaTernariaRecursiva(const vector<int>& arr, int esq, int dir, int x) {
    // Caso base 1: Se o intervalo for vazio ou invalido (esq >= dir), elemento nao existe
    if (esq >= dir) {
        return -1;
    }

    // Divide o intervalo atual em tres partes
    int terco = (dir - esq) / 3;

    // Calcula os dois indices divisores
    int meio1 = esq + terco;
    int meio2 = dir - 1 - terco;

    // Caso base 2: Elemento encontrado no primeiro divisor
    if (arr[meio1] == x) {
        return meio1;
    }

    // Caso base 3: Elemento encontrado no segundo divisor
    if (arr[meio2] == x) {
        return meio2;
    }

    // Caso recursivo 1: O alvo e menor que arr[meio1] -> busca em [esq, meio1)
    if (x < arr[meio1]) {
        return buscaTernariaRecursiva(arr, esq, meio1, x);
    }

    // Caso recursivo 2: O alvo e maior que arr[meio2] -> busca em [meio2 + 1, dir)
    if (x > arr[meio2]) {
        return buscaTernariaRecursiva(arr, meio2 + 1, dir, x);
    }

    // Caso recursivo 3: O alvo esta entre arr[meio1] e arr[meio2] -> busca em [meio1 + 1, meio2)
    return buscaTernariaRecursiva(arr, meio1 + 1, meio2, x);
}

int main() {
    // Otimizacao de entrada e saida padrao
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, x;

    // Leitura da quantidade N e do elemento alvo X
    if (!(cin >> n >> x)) {
        return 0;
    }

    // Alocacao dinamica do vetor ordenado
    vector<int> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    // Executa a busca ternaria recursiva no intervalo inicial semiaberto [0, n)
    int resultado = buscaTernariaRecursiva(arr, 0, n, x);

    // Exibicao do resultado
    if (resultado != -1) {
        cout << "Elemento encontrado no indice: " << resultado << "\n";
    } else {
        cout << "Elemento nao encontrado\n";
    }

    return 0;
}

