 * Exercício 7: Busca Ternária Iterativa
 * Convenção de intervalo: [esq, dir)
 */

#include <iostream>
#include <vector>

using namespace std;

/**
 * Realiza a busca ternaria iterativa no intervalo semiaberto [esq, dir).
 * O array DEVE estar previamente ordenado de forma crescente.
 * 
 * @param arr Vetor ordenado contendo os elementos inteiros.
 * @param esq Limite inferior do intervalo (inclusivo).
 * @param dir Limite superior do intervalo (exclusivo).
 * @param x Elemento procurado.
 * @return Indice onde o elemento foi encontrado, ou -1 caso contrario.
 */
int buscaTernariaIterativa(const vector<int>& arr, int esq, int dir, int x) {
    // Enquanto o intervalo contiver pelo menos 1 elemento (esq < dir)
    while (esq < dir) {
        // Divide o comprimento do intervalo atual em 3 partes
        int terco = (dir - esq) / 3;

        // Calcula os dois pontos divisores do intervalo
        int meio1 = esq + terco;
        int meio2 = dir - 1 - terco;

        // Caso 1: Elemento encontrado no primeiro ponto divisor
        if (arr[meio1] == x) {
            return meio1;
        }

        // Caso 2: Elemento encontrado no segundo ponto divisor
        if (arr[meio2] == x) {
            return meio2;
        }

        // Caso 3: O alvo e menor que arr[meio1] -> busca no primeiro terco [esq, meio1)
        if (x < arr[meio1]) {
            dir = meio1;
        }
        // Caso 4: O alvo e maior que arr[meio2] -> busca no terceiro terco [meio2 + 1, dir)
        else if (x > arr[meio2]) {
            esq = meio2 + 1;
        }
        // Caso 5: O alvo esta no terco central -> busca em [meio1 + 1, meio2)
        else {
            esq = meio1 + 1;
            dir = meio2;
        }
    }

    // Elemento nao encontrado no intervalo
    return -1;
}

int main() {
    // Otimizacao de entrada e saida padrao
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, x;

    // Leitura da quantidade N e do elemento alvo X
    if (!(cin >> n >> x)) {
        return 0;
    }

    // Alocacao dinamica do vetor ordenado
    vector<int> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    // Executa a busca ternaria iterativa no intervalo semiaberto [0, n)
    int resultado = buscaTernariaIterativa(arr, 0, n, x);

    // Exibicao do resultado
    if (resultado != -1) {
        cout << "Elemento encontrado no indice: " << resultado << "\n";
    } else {
        cout << "Elemento nao encontrado\n";
    }

    return 0;
}

