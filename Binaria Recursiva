 * Exercício 6: Busca Binária Recursiva
 * Convenção de intervalo: [esq, dir)
 */

#include <iostream>
#include <vector>

using namespace std;

/**
 * Realiza a busca binaria recursiva no intervalo semiaberto [esq, dir).
 * O array DEVE estar previamente ordenado de forma crescente.
 * 
 * @param arr Vetor ordenado contendo os elementos inteiros.
 * @param esq Limite inferior do intervalo (inclusivo).
 * @param dir Limite superior do intervalo (exclusivo).
 * @param x Elemento procurado.
 * @return Indice onde o elemento foi encontrado, ou -1 caso contrario.
 */
int buscaBinariaRecursiva(const vector<int>& arr, int esq, int dir, int x) {
    // Caso base 1: O intervalo e invalido ou vazio quando esq >= dir
    if (esq >= dir) {
        return -1;
    }

    // Calcula o ponto medio evitando overflow aritmetico
    int meio = esq + (dir - esq) / 2;

    // Caso base 2: O elemento foi encontrado exatamente no meio
    if (arr[meio] == x) {
        return meio;
    }

    // Caso recursivo 1: O alvo e menor que o valor do meio
    // Busca na metade esquerda no intervalo semiaberto [esq, meio)
    if (x < arr[meio]) {
        return buscaBinariaRecursiva(arr, esq, meio, x);
    }

    // Caso recursivo 2: O alvo e maior que o valor do meio
    // Busca na metade direita no intervalo semiaberto [meio + 1, dir)
    return buscaBinariaRecursiva(arr, meio + 1, dir, x);
}

int main() {
    // Otimizacao das operacoes de entrada e saida padrao
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, x;

    // Leitura da quantidade N e do elemento alvo X
    if (!(cin >> n >> x)) {
        return 0;
    }

    // Alocacao dinamica do vetor ordenado
    vector<int> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    // Executa a busca binaria recursiva no intervalo inicial [0, n)
    int resultado = buscaBinariaRecursiva(arr, 0, n, x);

    // Exibicao do resultado
    if (resultado != -1) {
        cout << "Elemento encontrado no indice: " << resultado << "\n";
    } else {
        cout << "Elemento nao encontrado\n";
    }

    return 0;
}

