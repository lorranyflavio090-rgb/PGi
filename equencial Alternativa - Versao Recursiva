
/**
 * Trabalho 1 - Estruturas de Dados Básicas 1
 * Exercício 4: Busca Sequencial Alternativa - Versão Recursiva
 * Convenção de intervalo: [esq, dir)
 */

#include <iostream>
#include <vector>

using namespace std;

/**
 * Realiza a busca sequencial alternativa recursiva no intervalo semiaberto [esq, dir).
 * A cada chamada recursiva, inspeciona as duas extremidades atuais do intervalo
 * e reduz o problema para [esq + 1, dir - 1).
 * 
 * @param arr Vetor contendo os elementos inteiros.
 * @param esq Limite inferior do intervalo (inclusivo).
 * @param dir Limite superior do intervalo (exclusivo).
 * @param x Elemento procurado.
 * @return Indice onde o elemento foi encontrado, ou -1 caso contrario.
 */
int buscaSequencialAlternativaRecursiva(const vector<int>& arr, int esq, int dir, int x) {
    // Caso base 1: Se o intervalo for vazio ou invalido, o elemento nao esta presente
    if (esq >= dir) {
        return -1;
    }

    // Verifica a extremidade esquerda do intervalo atual
    if (arr[esq] == x) {
        return esq;
    }

    // Como 'dir' e exclusivo, o elemento da extremidade direita esta em 'dir - 1'
    int ultimo = dir - 1;

    // Se 'esq' e 'ultimo' forem a mesma posicao, nao precisamos checar a direita novamente
    if (esq == ultimo) {
        return -1;
    }

    // Verifica a extremidade direita do intervalo atual
    if (arr[ultimo] == x) {
        return ultimo;
    }

    // Chamada recursiva: avanca o limite esquerdo e recua o limite direito
    // Novo intervalo semiaberto: [esq + 1, dir - 1)
    return buscaSequencialAlternativaRecursiva(arr, esq + 1, dir - 1, x);
}

int main() {
    // Otimizacao de entrada e saida padrao
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, x;

    // Leitura da quantidade N e do elemento alvo X
    if (!(cin >> n >> x)) {
        return 0;
    }

    // Alocacao dinamica do vetor para suportar testes de larga escala
    vector<int> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    // Execucao da busca recursiva no intervalo inicial semiaberto [0, n)
    int resultado = buscaSequencialAlternativaRecursiva(arr, 0, n, x);

    // Exibicao do resultado
    if (resultado != -1) {
        cout << "Elemento encontrado no indice: " << resultado << "\n";
    } else {
        cout << "Elemento nao encontrado\n";
    }

    return 0;
}
